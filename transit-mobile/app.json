{
  "expo": {
    "name": "Transit Optimizer",
    "slug": "transit-optimizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030712"
      },
      "package": "com.srikar.transitoptimizer"
    },
    "ios": {
      "bundleIdentifier": "com.srikar.transitoptimizer"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "color": "#378ADD"
        }
      ],
      "expo-font"
    ],
    "scheme": "transit"
  }
}
